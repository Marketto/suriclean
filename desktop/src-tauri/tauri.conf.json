{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuriClean",
  "version": "1.0.0",
  "identifier": "com.suriclean.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SuriClean",
        "width": 1180,
        "height": 720,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "La suricata spazzina che libera spazio",
    "longDescription": "SuriClean trova cache, file temporanei, dati di Claude e Codex, dipendenze ricreabili, repo git dimenticati, duplicati e file giganti, e li sposta nel Cestino quando lo decidi tu.",
    "category": "Utility",
    "copyright": "Marco Ricupero",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["git"]
      }
    }
  }
}
